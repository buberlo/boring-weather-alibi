# Required environment variables
#
# Get an OpenWeather API key from:
# https://openweathermap.org/api
#
# Copy this file to .env.local and fill in the value below.
OPENWEATHER_API_KEY=

# Optional: local SQLite database path
# Defaults to ./data/excuses.db if not set.
# DB_PATH=./data/excuses.db

# Optional: base URL used in generated calendar output
# Useful when running on a custom domain or behind a proxy.
# APP_URL=http://localhost:3000